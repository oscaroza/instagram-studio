# Public URL of the deployed app, no trailing slash
APP_BASE_URL=https://your-app.onrender.com
APP_SECRET_KEY=replace-with-a-long-random-secret
STUDIO_ACCESS_CODE=
STUDIO_SESSION_HOURS=24
STUDIO_IDLE_MINUTES=10
# Optional security defaults: 5 failed attempts over 15 min, then 15 min lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# false en HTTP local; true sur Render/HTTPS
STUDIO_COOKIE_SECURE=false

# Groq (historical CEREBRAS_* variable names kept for compatibility)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=openai/gpt-oss-20b
CEREBRAS_BASE_URL=https://api.groq.com/openai/v1

# Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-app.onrender.com/auth/instagram/callback
INSTAGRAM_API_BASE=https://graph.instagram.com
INSTAGRAM_API_VERSION=v26.0

# Optional: for single-user V1, paste a long-lived/user access token directly.
# This lets you test publishing before completing OAuth in Meta Developer.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Trial Reels use Meta's documented trial_params. Set false for an instant kill switch.
# Normal Reel publishing remains unchanged.
ENABLE_TRIAL_REELS=true

# MongoDB (metadata, calendar, subscriptions, encrypted Instagram token)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?appName=instagram-studio
MONGODB_DATABASE=instagram_studio

# Cloudinary (scheduled videos and JPEG images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=instagram-studio

# Durable scheduled-media storage. "auto" prefers R2, then keeps Cloudinary
# as a legacy fallback for existing media until it has been emptied.
MEDIA_STORAGE_BACKEND=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=instagram-studio
# Production: use an R2 custom domain, e.g. https://media.example.com
R2_PUBLIC_BASE_URL=
R2_FOLDER=instagram-studio
# Separate read-only token for GraphQL dashboard metrics.
CLOUDFLARE_ANALYTICS_API_TOKEN=
# Safety cap below R2 Standard's 10 GB-month free allowance.
R2_MAX_STORAGE_GB=9

# PWA Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# UptimeRobot keeps the free web service awake; the internal worker checks due jobs.
SCHEDULER_INTERVAL_SECONDS=30

# Upload behavior
MAX_UPLOAD_MB=250
